{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hujja.dev/schemas/rule-file.schema.json",
  "title": "Hujja Rule File",
  "description": "Declarative rule file for one Shariah screening standard. Encodes facts (thresholds, comparators, provenance) only -- no engine logic.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_file", "standard", "methodology", "review", "ratio_screens"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version of this rule-file FORMAT, not the methodology or this file's own content."
    },
    "rule_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semver of this rule file's content. Bump on every change per the rule-change checklist."
        }
      }
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "provider"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "Canonical machine identifier, e.g. DJIM_SPDJI. Matches Engine(standards=[...])."
        },
        "name": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "version", "official_url", "verified_on"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "The methodology document's own edition label, e.g. \"2026-02\"."
        },
        "official_url": { "type": "string", "format": "uri" },
        "verified_on": {
          "type": "string",
          "format": "date",
          "description": "Date a human or session read the primary source in full."
        }
      }
    },
    "review": { "$ref": "#/$defs/review" },
    "business_activity_screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excluded_sectors", "tolerance_test"],
      "properties": {
        "excluded_sectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        },
        "tolerance_test": { "$ref": "#/$defs/ratioScreen" }
      }
    },
    "ratio_screens": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ratioScreen" }
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "scope", "date"],
      "properties": {
        "status": { "type": "string", "enum": ["unreviewed", "expert_reviewed"] },
        "reviewer": { "type": ["string", "null"], "description": "Named only with the reviewer's written consent." },
        "scope": { "type": ["string", "null"], "description": "What was checked, e.g. \"rule file v1.0.0 checked against official source\"." },
        "date": { "type": ["string", "null"], "format": "date" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "expert_reviewed" } } },
          "then": {
            "properties": {
              "reviewer": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "format": "date" }
            }
          }
        }
      ]
    },
    "factExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts"],
      "properties": {
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": "Fact IDs from the fact model. If more than one, they are summed."
        },
        "averaging_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "length", "method"],
          "properties": {
            "unit": { "type": "string", "enum": ["months"] },
            "length": { "type": "integer", "minimum": 1 },
            "method": { "type": "string", "enum": ["trailing_average"] }
          }
        }
      }
    },
    "transitionBuffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tolerance_band", "consecutive_periods_before_flip", "immediate_breach_beyond_band"],
      "properties": {
        "tolerance_band": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Width of the buffer band, expressed as a fraction in the SAME unit as `threshold`. 0.02 means 2 percentage points; with threshold 0.33 the buffer ceiling is 0.35."
        },
        "consecutive_periods_before_flip": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of consecutive evaluation periods over the threshold, while inside the band, before the status flips. The length of a period is `evaluation_frequency` on the same screen."
        },
        "immediate_breach_beyond_band": {
          "type": "boolean",
          "description": "If true, a ratio beyond threshold + tolerance_band flips the status immediately, without waiting for consecutive_periods_before_flip."
        }
      }
    },
    "ratioScreen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "numerator", "denominator", "comparator", "threshold", "evaluation_frequency"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "numerator": { "$ref": "#/$defs/factExpression" },
        "denominator": { "$ref": "#/$defs/factExpression" },
        "comparator": { "type": "string", "enum": ["<", "<=", ">", ">=", "=="] },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Expressed as a fraction, not a percentage. 0.33 means 33%."
        },
        "evaluation_frequency": {
          "type": ["string", "null"],
          "enum": ["annual", "quarterly", "monthly", null],
          "description": "How often the standard re-evaluates this screen. null means the cadence has NOT been verified against the official document (TO VERIFY). The slot is required so an unverified cadence is explicit rather than invisible."
        },
        "transition_buffer": { "$ref": "#/$defs/transitionBuffer" }
      }
    }
  }
}
